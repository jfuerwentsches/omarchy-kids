#!/bin/bash
# Switches the active Omarchy Kids age tier.
#
# Usage: omarchy-kids-set-tier <tier> [theme]
# Example: omarchy-kids-set-tier mini
#          omarchy-kids-set-tier mini meerjungfrauen
#
# Installs every theme under tiers/<tier>/themes/ (plus any dropped into
# ~/.config/omarchy-kids/themes/<tier>/ — same shape, no code change needed
# to add one) as an Omarchy theme, and activates either the explicit
# [theme] argument or the tier's default-theme.txt. Also (tier-dependent)
# installs the tier's Quickshell launcher plugin, replaces
# ~/.config/hypr/hyprland.lua with the tier's locked-down kiosk bindings,
# and masks unused VTs so Ctrl+Alt+F<n> can't reach a raw login shell.
#
# Only tier "mini" (age 5-7) is implemented so far — see tiers/mini/.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TIER="${1:-}"
THEME_ID_ARG="${2:-}"

if [[ -z $TIER ]]; then
  echo "Usage: omarchy-kids-set-tier <tier> [theme]" >&2
  echo "Available tiers:" >&2
  for dir in "$SCRIPT_DIR"/*/themes; do
    [[ -d $dir ]] || continue
    basename "$(dirname "$dir")" >&2
  done
  exit 1
fi

TIER_DIR="$SCRIPT_DIR/$TIER"
TIER_THEMES_SRC="$TIER_DIR/themes"
if [[ ! -d $TIER_THEMES_SRC ]]; then
  echo "Unknown tier '$TIER' (no themes at $TIER_THEMES_SRC)" >&2
  exit 1
fi

if [[ -n $THEME_ID_ARG ]]; then
  DEFAULT_THEME_ID="$THEME_ID_ARG"
elif [[ -f "$TIER_THEMES_SRC/default-theme.txt" ]]; then
  DEFAULT_THEME_ID="$(<"$TIER_THEMES_SRC/default-theme.txt")"
else
  echo "No [theme] given and no default-theme.txt under $TIER_THEMES_SRC" >&2
  exit 1
fi

mkdir -p "$HOME/.config/omarchy/themes"

# Install every theme this tier ships, plus any the parent has dropped into
# ~/.config/omarchy-kids/themes/<tier>/ (same directory shape — a theme is
# just a folder with a colors.toml, no code change needed to add one). Each
# becomes its own installed Omarchy theme (omarchy-kids-<tier>-<theme-id>),
# so switching between them afterwards is just the normal
# omarchy-theme-set mechanism.
USER_THEMES_SRC="$HOME/.config/omarchy-kids/themes/$TIER"
for themes_src in "$TIER_THEMES_SRC" "$USER_THEMES_SRC"; do
  [[ -d $themes_src ]] || continue
  for theme_dir in "$themes_src"/*/; do
    [[ -f "${theme_dir}colors.toml" ]] || continue
    theme_id="$(basename "$theme_dir")"
    rm -rf "$HOME/.config/omarchy/themes/omarchy-kids-$TIER-$theme_id"
    cp -r "$theme_dir" "$HOME/.config/omarchy/themes/omarchy-kids-$TIER-$theme_id"
  done
done

THEME_NAME="omarchy-kids-$TIER-$DEFAULT_THEME_ID"
if [[ ! -d "$HOME/.config/omarchy/themes/$THEME_NAME" ]]; then
  echo "Theme '$DEFAULT_THEME_ID' for tier '$TIER' not found under $TIER_THEMES_SRC or $USER_THEMES_SRC" >&2
  exit 1
fi

omarchy-theme-set "$THEME_NAME"

# Launcher plugin + its app list, if this tier ships one. Third-party
# overlay/menu plugins are opt-in in Omarchy: dropping the plugin directory
# into ~/.config/omarchy/plugins/ is not enough on its own, it also has to
# be listed in shell.json's top-level plugins[] array or the shell logs
# "plugin not enabled, not summoning" and silently no-ops (see
# PluginRegistry.qml's isEnabled()).
if [[ -d "$TIER_DIR/launcher" ]]; then
  mkdir -p "$HOME/.config/omarchy/plugins" "$HOME/.config/omarchy-kids"
  SHELL_JSON="$HOME/.config/omarchy/shell.json"
  [[ -f $SHELL_JSON ]] || echo '{}' > "$SHELL_JSON"
  for plugin_dir in "$TIER_DIR/launcher"/*/; do
    [[ -f "${plugin_dir}manifest.json" ]] || continue
    plugin_id="$(basename "$plugin_dir")"
    rm -rf "$HOME/.config/omarchy/plugins/$plugin_id"
    cp -r "$plugin_dir" "$HOME/.config/omarchy/plugins/$plugin_id"

    tmp_json="$(mktemp)"
    jq --arg id "$plugin_id" \
      '.plugins = ((.plugins // []) | if any(.id == $id) then . else . + [{id: $id}] end)' \
      "$SHELL_JSON" > "$tmp_json" && mv "$tmp_json" "$SHELL_JSON"
  done
  if [[ -f "$TIER_DIR/launcher/apps.json" ]]; then
    # Preferred path: hand the tier's app list to agentd, which becomes the
    # sole writer of launcher-apps.json from then on (base tiles ++ active
    # temporary unlocks from `agent unlock`/`agent override` — see
    # docs/agent-protocol.md). Falls back to the old direct copy if agentd
    # isn't reachable yet (e.g. a fresh box before the daemon is enabled),
    # so tier switching still works without hard-depending on it.
    if ! omarchy-kids-agent set-tier "$TIER" --apps-file "$TIER_DIR/launcher/apps.json" >/dev/null 2>&1; then
      echo "omarchy-kids-set-tier: omarchy-kids-agentd not reachable, falling back to a direct copy of launcher-apps.json" >&2
      cp "$TIER_DIR/launcher/apps.json" "$HOME/.config/omarchy-kids/launcher-apps.json"
    fi
  fi
fi

# Hyprland kiosk bindings, if this tier ships an override. The stock config
# is backed up once so it can be restored when moving to a tier that
# doesn't ship its own hyprland.lua.
if [[ -f "$TIER_DIR/hypr/hyprland.lua" ]]; then
  HYPR_CONF="$HOME/.config/hypr/hyprland.lua"
  HYPR_BACKUP="$HYPR_CONF.pre-omarchy-kids"
  if [[ -f $HYPR_CONF && ! -f $HYPR_BACKUP ]]; then
    cp "$HYPR_CONF" "$HYPR_BACKUP"
  fi
  cp "$TIER_DIR/hypr/hyprland.lua" "$HYPR_CONF"
  hyprctl reload >/dev/null 2>&1 || true
fi

# First-run replacement (issue #30), if this tier ships one: Omarchy's own
# first-run orchestrator is all prompts an adult should see (system update,
# keybinding cheatsheet, dictation/fingerprint/default-agent invitations) and
# has no per-step toggle, only the one all-or-nothing "first-run-user"
# done-marker. Install the tier's autostart.lua (which replicates just the
# few silent, non-prompt steps worth keeping — see tiers/mini/hypr/
# autostart.lua) and mark that done-marker ourselves, BEFORE the child's
# first graphical login, so Omarchy's own handler finds it already done and
# never shows any of those prompts.
if [[ -f "$TIER_DIR/hypr/autostart.lua" ]]; then
  AUTOSTART_CONF="$HOME/.config/hypr/autostart.lua"
  AUTOSTART_BACKUP="$AUTOSTART_CONF.pre-omarchy-kids"
  if [[ -f $AUTOSTART_CONF && ! -f $AUTOSTART_BACKUP ]]; then
    cp "$AUTOSTART_CONF" "$AUTOSTART_BACKUP"
  fi
  cp "$TIER_DIR/hypr/autostart.lua" "$AUTOSTART_CONF"
  omarchy-done mark first-run-user
  hyprctl reload >/dev/null 2>&1 || true
fi

# VT lockdown: this tier has no terminal, so Ctrl+Alt+F<n> switching to a
# raw getty and logging back in with the same account must not work either
# — the kiosk restriction is a UI-layer thing otherwise, not an access
# control. Mask the gettys for the unused VTs; VT1 (the graphical session)
# stays untouched.
if [[ $TIER == "mini" ]]; then
  sudo systemctl mask --now getty@tty2.service getty@tty3.service getty@tty4.service getty@tty5.service getty@tty6.service >/dev/null 2>&1 || true
fi

# Autonomous OS updates (issue #31): this tier suppresses Omarchy's own
# child-facing update prompt entirely (issue #30), so without a replacement
# this machine would never update at all. Decided: fully autonomous, no
# parent/Control-Center trigger -- install + enable a system-level timer
# that runs `omarchy-update -y` unattended on its own schedule.
if [[ $TIER == "mini" && -d "$TIER_DIR/systemd" ]]; then
  sudo install -Dm644 "$TIER_DIR/systemd/omarchy-kids-update.service" \
    /etc/systemd/system/omarchy-kids-update.service
  sudo install -Dm644 "$TIER_DIR/systemd/omarchy-kids-update.timer" \
    /etc/systemd/system/omarchy-kids-update.timer
  sudo systemctl enable --now omarchy-kids-update.timer >/dev/null 2>&1 || true

  # Also silence Omarchy's per-login "pending migrations" toast, which opens
  # a terminal on click: `omarchy-update -y` already runs the migration step
  # itself, so this should never have anything to say under normal
  # operation, but a failed/partial run could leave one pending -- and a
  # kiosk child should never be offered an actionable terminal invitation
  # either way.
  systemctl --user mask omarchy-update-user-notify.service >/dev/null 2>&1 || true
fi

# Bar visibility: the kiosk Hyprland config above disables every default
# binding, but never touched the Omarchy top bar itself — its own menu icon
# (omarchy.menu) still opens the normal Omarchy menu (terminal, file
# manager, ...) by mouse/touch regardless of what keybindings exist,
# defeating the whole point of the lockdown. Hide it for tiers with a kiosk
# launcher; the launcher grid carries its own power-off tile (Launcher.qml)
# so losing the bar doesn't also lose the ability to shut the machine down.
if [[ $TIER == "mini" ]]; then
  omarchy-toggle-bar on >/dev/null 2>&1 || true
else
  omarchy-toggle-bar off >/dev/null 2>&1 || true
fi

if [[ -d "$TIER_DIR/launcher" ]]; then
  # Quickshell's own live plugin reload ("Local plugin changed, reloading")
  # doesn't reliably pick up structural QML changes (new/changed component
  # trees) — observed hanging onto stale layout after a plugin's first
  # install until the shell process itself was restarted. Cheap and
  # respawns automatically (Hyprland autostarts it), so just do it here
  # rather than leave a half-applied plugin.
  pkill -f 'quickshell -n -p' >/dev/null 2>&1 || true
fi

echo "Omarchy Kids tier set to '$TIER' (theme: $THEME_NAME)"
