# Maintainer: Omarchy Kids
pkgname=omarchy-kids-control
pkgver=0.1.0
pkgrel=1
pkgdesc="Omarchy Kids parent-side Control Center (core, GUI, status poll)"
arch=('x86_64' 'aarch64')
url="https://github.com/jfuerwentsches/omarchy-kids"
license=('MIT')
depends=('qt6-base' 'tomlplusplus')
makedepends=('cmake' 'ninja')
checkdepends=('gtest')
source=()
sha256sums=()

pkgver() {
  cd "$startdir/.."
  echo "$pkgver"
}

build() {
  cd "$startdir/.."
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DOMARCHY_KIDS_BUILD_TUI=OFF
  cmake --build build --target omarchy-kids-control omarchy-kids-control-core-tests
}

check() {
  cd "$startdir/.."
  ctest --test-dir build --output-on-failure
}

package() {
  cd "$startdir/.."

  install -Dm755 build/gui/omarchy-kids-control \
    "$pkgdir/usr/bin/omarchy-kids-control"

  install -Dm644 packaging/systemd/omarchy-kids-control-poll.service \
    "$pkgdir/usr/lib/systemd/user/omarchy-kids-control-poll.service"
  install -Dm644 packaging/systemd/omarchy-kids-control-poll.timer \
    "$pkgdir/usr/lib/systemd/user/omarchy-kids-control-poll.timer"
}

post_install() {
  systemctl --global enable omarchy-kids-control-poll.timer || true
}

post_upgrade() {
  post_install
}

post_remove() {
  systemctl --global disable omarchy-kids-control-poll.timer || true
}
