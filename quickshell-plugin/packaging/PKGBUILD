# Maintainer: Omarchy Kids
pkgname=omarchy-kids-quickshell-plugin
pkgver=0.1.0
pkgrel=1
pkgdesc="Omarchy Kids Quickshell bar widget and enable helper"
arch=('any')
url="https://github.com/jfuerwentsches/omarchy-kids"
license=('MIT')
depends=('bash' 'jq' 'omarchy-kids-control' 'quickshell')
source=()
sha256sums=()

pkgver() {
  cd "$startdir/.."
  echo "$pkgver"
}

package() {
  cd "$startdir/.."

  install -d "$pkgdir/usr/share/omarchy-kids/quickshell-plugin"
  cp -a omarchy-kids.control \
    "$pkgdir/usr/share/omarchy-kids/quickshell-plugin/"

  install -Dm755 omarchy-kids-quickshell-plugin-enable \
    "$pkgdir/usr/bin/omarchy-kids-quickshell-plugin-enable"
}
